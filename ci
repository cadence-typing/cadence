#!/bin/sh
# Cadence operator entrypoint (B-03).
#
# Wrappers invoke the pinned Compose service; gate logic lives in xtask.
# The wrapper avoids depending on a host Rust install for gate execution.
# `local` runs xtask directly on the host for iteration only — local runs
# are feedback, never qualification evidence.
set -eu

COMPOSE_FILE="$(dirname "$0")/docker/docker-compose.yml"

usage() {
    cat <<'EOF'
usage: ./ci <command>
  feedback                 fast local feedback via compose (clippy + unit tests)
  quality                  run the quality gate via compose
  gate <id>                run one required gate by ID
  gates                    list required gates and their honest states
  local <xtask-args...>    run cargo xtask on the host (feedback only)
EOF
}

command="${1:-}"
[ -n "$command" ] || { usage >&2; exit 1; }
shift

case "$command" in
    feedback)
        exec docker compose -f "$COMPOSE_FILE" run --rm quality
        ;;
    quality)
        exec docker compose -f "$COMPOSE_FILE" run --rm quality
        ;;
    gate)
        [ $# -ge 1 ] || { echo "usage: ./ci gate <gate-id>" >&2; exit 1; }
        exec docker compose -f "$COMPOSE_FILE" run --rm "$1"
        ;;
    gates)
        exec docker compose -f "$COMPOSE_FILE" run --rm quality cargo run -p xtask -- gates
        ;;
    local)
        exec cargo run -q -p xtask -- "$@"
        ;;
    *)
        echo "unknown command: $command" >&2
        usage >&2
        exit 1
        ;;
esac
