{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cadence:headless-response:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "maxLength": 20
        },
        "ok": {
          "const": true
        },
        "result": {
          "type": "object",
          "required": [
            "state_revision",
            "event_seq"
          ],
          "properties": {
            "state_revision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "maxLength": 20
            },
            "event_seq": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "maxLength": 20
            },
            "durable_commit_seq": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "maxLength": 20
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "v",
        "id",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "MalformedJson",
                "LineTooLong",
                "UnsupportedVersion",
                "InvalidId",
                "UnknownField",
                "UnknownOperation",
                "InvalidArgument",
                "HelloRequired",
                "RequestIdConflict",
                "RequestExpired",
                "StaleState",
                "BarrierOutOfScope",
                "BarrierTimeout"
              ]
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
