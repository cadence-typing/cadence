  then
    if t.first_attempted <= t.content_attempts
    then
      if t.correct_attempts <= t.content_attempts
      then
        if t.first_correct <= t.correct_attempts
        then
          if t.overflow_attempts <= t.content_attempts
          then
            if t.correct_units <= t.correct_attempts
            then ok (t.correct_digits <= t.correct_units)
            else ok false
          else ok false
        else ok false
      else ok false
